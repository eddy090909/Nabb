# Postgres connection string (e.g. from Supabase, Neon, Railway, or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random long string used to sign session JWTs and login-code cookies
SESSION_SECRET="generate-a-long-random-string"

# Secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>` - set the
# same value in your Vercel project's env vars so only Vercel's scheduler can
# trigger /api/cron/check-seats
CRON_SECRET="generate-another-long-random-string"

# Optional: override registration windows (ET calendar days, inclusive).
# Format: YYYY-MM-DD:YYYY-MM-DD,YYYY-MM-DD:YYYY-MM-DD
# Defaults (in code): Fall add/drop 2026-09-07:2026-09-18, spring adjustment
# 2026-11-18:2026-11-21 (Nov end is a placeholder — confirm closer to November).
# REGISTRATION_WINDOWS="2026-09-07:2026-09-18,2026-11-18:2026-11-21"

# Which WesMaps site to read courses and seats from. Wesleyan runs two right now:
#   legacy (default) = old WesMaps, owaprod-pub.wesleyan.edu (what faculty recommend as of Nov 2026)
#   new              = webapps.wesleyan.edu/wesmaps (NOT implemented yet; see src/lib/wesmaps-new.ts)
# WESMAPS_SOURCE="legacy"

# Resend (https://resend.com) for transactional email - login codes + seat alerts
RESEND_API_KEY="re_xxxxxxxx"
NOTIFY_FROM_EMAIL="alerts@nabb.app"

# Twilio (https://twilio.com) for SMS seat alerts
TWILIO_ACCOUNT_SID="ACxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxx"
TWILIO_FROM_NUMBER="+1xxxxxxxxxx"

# Public URL of your deployed Nabb app, used in notification text
APP_URL="https://nabb.vercel.app"

# Optional DEMO-ONLY bypass for /api/auth/verify-code. If set, submitting this
# exact code signs in any @wesleyan.edu email without a LoginCode row.
# Leave unset/empty in real deployments. Remove before production use.
# DEMO_BYPASS_CODE="482913"

# Neon direct (unpooled) URL — used by Prisma migrations via directUrl
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname"
